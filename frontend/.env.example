# ─────────────────────────────────────────────────────────────────────────────
# ResourceAdvisor — Frontend Environment Variables Template
# Copy this file to .env and replace placeholders with your actual configuration.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase Client Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API Endpoint URL (optional, defaults to /api proxy in Vite dev server)
VITE_API_URL=http://localhost:5001
