# ─────────────────────────────────────────────────────────────────────────────
# ResourceAdvisor — Backend Environment Variables Template
# Copy this file to .env and replace placeholders with your actual credentials.
# ─────────────────────────────────────────────────────────────────────────────

# Server Port
PORT=5001

# Client Origin (CORS whitelist)
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign and verify JWT authentication tokens
JWT_SECRET=your_jwt_secret_here

# Supabase Project Configuration (PostgreSQL Database)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Google Gemini API Key (Required for AI insights, forecasts & telemetry chat)
GEMINI_API_KEY=your_gemini_api_key_here
